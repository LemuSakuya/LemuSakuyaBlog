---
import MainGridLayout from "@layouts/MainGridLayout.astro";

import DiaryFeed from "../components/features/diary/DiaryFeed.svelte";
import { siteConfig } from "../config";
import initial from "../data/diary-seed.json";
import Key from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.diary) {
	return Astro.redirect("/404/");
}
const labels = {
	title: i18n(Key.diary),
	subtitle: i18n(Key.diarySubtitle),
	count: i18n(Key.diaryCount),
	all: i18n(Key.albumsFilterAll),
	empty: i18n(Key.diaryNoResults),
	tips: i18n(Key.diaryTips),
	minutes: i18n(Key.diaryMinutesAgo),
	hours: i18n(Key.diaryHoursAgo),
	days: i18n(Key.diaryDaysAgo),
	edit: i18n(Key.diaryEditor),
	offline: i18n(Key.diaryOffline),
};
---

<MainGridLayout title={labels.title} description={labels.subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<DiaryFeed client:load {initial} {labels} />
</MainGridLayout>
